{
  "name": "chatcoder",
  "private": true,
  "version": "0.12.4",
  "description": "Remote codex control via Telegram — monorepo root",
  "repository": "github:jerrielu/chatcoder",
  "bin": {
    "chatcoder": "bin/chatcoder.js"
  },
  "workspaces": [
    "packages/shared",
    "packages/bot",
    "packages/daemon",
    "packages/dashboard"
  ],
  "files": [
    "bin/chatcoder.js",
    "packages/shared/package.json",
    "packages/shared/dist",
    "packages/bot/dist",
    "packages/daemon/dist",
    "scripts/start.mjs"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "build:runtime": "tsc -b packages/shared packages/bot packages/daemon --pretty",
    "clean": "rm -rf packages/*/dist coverage",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -b packages/shared packages/bot packages/daemon packages/dashboard --pretty",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dev:chat": "npm run dev -w @chatcoder/bot",
    "dev:coder": "node bin/chatcoder.js",
    "pack:release": "npm run build:runtime && npm pack --pack-destination /tmp",
    "local": "npm run pack:release && npm install -g /tmp/chatcoder-0.12.4.tgz && pm2 restart chatcoder-coder chatcoder-chat",
    "pm2:start": "npm run build && node scripts/pm2-start.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "dev:dashboard": "npm run dev -w @chatcoder/dashboard"
  },
  "dependencies": {
    "@chatcoder/shared": "file:packages/shared",
    "@fastify/cors": "^9.0.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^4.28.0",
    "grammy": "^1.24.1",
    "kysely": "^0.27.3",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "prompts": "^2.4.2",
    "telegram-markdown-v2": "^0.0.5",
    "yaml": "^2.4.2",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitest/coverage-v8": "^1.5.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
